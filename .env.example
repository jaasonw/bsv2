# Environment Variables

## Required for AI Receipt Parsing
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the vision model used to read receipts.
# Must be a model with image input support on OpenRouter.
# Default: openai/gpt-5-mini  (11/11 on the receipt_samples benchmark,
#   ~$0.0023/receipt, ~16s). Faster alternatives, in order of accuracy:
#   google/gemini-3.1-flash-lite   9/11  ~$0.0007  ~4s
#   google/gemini-2.5-flash-lite   9/11  ~$0.0003  ~4s
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite

## Required for PocketBase Backend
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# For production, use your PocketBase instance URL:
# NEXT_PUBLIC_POCKETBASE_URL=https://your-pocketbase-instance.com
